# ========================================
# Angular + Node.js + VSCode Git Ignore
# ========================================

# Compiled output
/dist
/dist/*
/tmp
/out-tsc
/bazel-out

# Node dependencies
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled source #
*.com
*.class
*.dll
*.exe
*.o
*.so

# Logs
*.log
log/
logs/
*.tsbuildinfo

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Angular cache
.angular/cache/
.angular/cache

# Sass cache
.sass-cache/

# Environment files (se contiverem segredos)
src/environments/environment.ts
src/environments/environment.prod.ts

# Coverage reports
/coverage/

# Test logs
/libpeerconnection.log
testem.log

# Typings
/typings

# History plugin
.history/

# OS files
.DS_Store
Thumbs.db

# Others
/connect.lock
